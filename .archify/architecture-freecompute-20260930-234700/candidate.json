  "cards": [
    {
      "dot": "cyan",
      "title": "Local Authority & Zero-Trust Remote",
      "items": [
        "All filesystem operations, tools, undo history, and terminal approvals execute on the user's PC.",
        "The remote GPU container is an untrusted inference brain; it has zero access to local files or credentials.",
        "SecretScrubber redacts API keys, ephemeral tunnel URLs, and credentials before console display."
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-GPU Remote Inference",
      "items": [
        "Utilizes free Kaggle weekly compute (30 hours/week dual Tesla T4 GPUs with 30 GB total VRAM).",
        "llama-server balances layers 50/50 across CUDA0 and CUDA1 with 64K KV cache capacity.",
        "Supervisor proxy guards port :8081 with Bearer token authentication and health/VRAM telemetry."
      ]
    },
    {
      "dot": "rose",
      "title": "Resilient Ingress Transport",
      "items": [
        "Cloudflare HTTP/2 tunnel provides secure public edge ingress over standard TCP port 443.",
        "Enforcing HTTP/2 protocol prevents UDP/QUIC packet drops common on cloud sandbox firewalls.",
        "Seamless single-command local CLI connectivity via --remote-url without local port forwarding."
      ]
    }
  ]
