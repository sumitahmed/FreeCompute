---
import { ArrowRight, ArrowUpRight, Maximize2, X, Copy, Check, Monitor, Server, ShieldCheck, LockKeyhole, Folder, Terminal, Cpu } from '@lucide/astro';
interface Props {
  name: 'arrow' | 'external' | 'expand' | 'close' | 'copy' | 'check' | 'monitor' | 'server' | 'shield' | 'lock' | 'folder' | 'terminal' | 'cpu';
  class?: string;
}
const { name, class: className } = Astro.props;
const icons = {
  arrow: ArrowRight, external: ArrowUpRight, expand: Maximize2, close: X,
  copy: Copy, check: Check, monitor: Monitor, server: Server,
  shield: ShieldCheck, lock: LockKeyhole, folder: Folder, terminal: Terminal, cpu: Cpu,
};
const LucideIcon = icons[name];
---
<LucideIcon class={className} size={20} stroke-width={1.5} aria-hidden="true" focusable="false" />
