---
interface Props {
  name: 'arrow' | 'external' | 'github' | 'expand' | 'close' | 'copy' | 'check';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  arrow: ['M4 12h16', 'm14 6 6 6-6 6'],
  external: ['M7 17 17 7', 'M7 7h10v10'],
  expand: ['M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5'],
  close: ['m6 6 12 12', 'M18 6 6 18'],
  copy: ['M9 8h11v12H9z', 'M15 8V4H4v12h5'],
  check: ['m5 12 4 4L19 6'],
  github: ['M9 19c-4 1-4-2-6-2m12 5v-4c0-1-.3-1.7-1-2 3-.3 6-1.5 6-6A4.7 4.7 0 0 0 19 7c.3-1 .2-2.3-.2-3-1.4-.2-3 1-4 1a13 13 0 0 0-6 0C7.8 4.2 6.3 3.8 5.2 4c-.4.8-.5 2-.2 3a4.7 4.7 0 0 0-1 3c0 4.5 3 5.7 6 6-.7.3-1 1-1 2v4'],
};
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
