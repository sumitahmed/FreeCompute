---
import Capture from './Capture.astro';
import SectionHeading from './SectionHeading.astro';
import coding from '../assets/coding.png';
import inspection from '../assets/inspection.png';
import research from '../assets/research.png';
import status from '../assets/status.png';
const scenes = [
  {
    id: 'coding', title: 'Write code', command: 'A prompt, then code',
    description: 'Streamed answers with readable code and Markdown in your terminal.',
    image: coding, label: 'Coding output',
    alt: 'Actual FreeCompute CLI: a request for the first ten primes in Java and syntax-highlighted First10Primes code from the configured Qwen worker.',
    caption: 'Java code returned by the configured Qwen GGUF worker. This capture shows generated output; it does not show the Java program being executed.',
  },
  {
    id: 'inspection', title: 'Inspect & test', command: 'Read → propose → approve',
    description: 'Read project files. Review proposed edits and commands before local execution.',
    image: inspection, label: 'File inspection & proposed test',
    alt: 'Actual FreeCompute CLI: local list and read tool activity, two calculator tests, a proposed Python unittest command, and a model request for permission.',
    caption: 'The agent inspects calculator files and proposes a test command. Permission is pending in this capture; this is not a test-pass receipt.',
  },
  {
    id: 'research', title: 'Search the web', command: 'search_web / fetch_url',
    description: 'Search and fetch public pages through local tools. Check sources and model answers.',
    image: research, label: 'Web-tool activity',
    alt: 'Actual FreeCompute CLI: the search_web tool completes a football-related query before the model returns an answer.',
    caption: 'A real search_web event followed by model output. The answer in the screenshot is not independently fact-checked or endorsed.',
  },
  {
    id: 'status', title: 'Check your worker', command: '/status',
    description: 'See available hardware observations, sample age, and what remains unknown.',
    image: status, label: 'Worker status',
    alt: 'Actual FreeCompute status: a healthy Kaggle worker, two observed Tesla T4 GPUs with VRAM usage, and unknown session limits, CPU, RAM and weekly quota.',
    caption: 'Two Tesla T4 GPUs observed in this session. Unknown CPU, RAM, provider quota and session limits remain explicitly unknown.',
  },
];
---
<section id="inside" class="section container" aria-labelledby="inside-title">
  <SectionHeading index="03" label="Inside the CLI" title="Less ceremony. More actual work." id="inside-title">
    <p>Real captures from a connected Kaggle session. Choose a view, or open a screenshot to inspect it.</p>
  </SectionHeading>
  <div class="gallery" data-gallery>
    <nav class="gallery-nav" aria-label="CLI screenshots" data-gallery-nav>
      {scenes.map((scene, index) => <a class="gallery-tab" href={`#scene-${scene.id}`} id={`tab-${scene.id}`} data-gallery-tab data-panel={`scene-${scene.id}`}>
        <span class="gallery-tab-index" aria-hidden="true">0{index + 1}</span>
        <span><strong>{scene.title}</strong><span class="gallery-tab-command">{scene.command}</span><span class="gallery-tab-description">{scene.description}</span></span>
      </a>)}
    </nav>
    <div class="gallery-panels">
      {scenes.map((scene) => <div id={`scene-${scene.id}`} data-gallery-panel>
        <Capture image={scene.image} alt={scene.alt} label={scene.label} caption={scene.caption} />
      </div>)}
    </div>
  </div>
  <div class="workflow-notes">
    <div><p class="mono">/sessions · /resume · /diff · /undo</p><h3>Pick up where you left off.</h3><p>Saved conversations, recorded changes and approved undo are managed by the local Core. Reopening a completed task does not replay its effects.</p></div>
    <div><p class="mono">/model · /workers · /skills</p><h3>A workflow you can configure.</h3><p>Choose configured model and worker routes, or use bundled and project skills. Type <code>/</code> for the live command menu.</p></div>
  </div>
</section>
