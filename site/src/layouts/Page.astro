---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import primaryFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; }
const {
  title = 'FreeCompute — More compute. Same workspace.',
  description = 'A local CLI agent for open-weight AI. Connect a GPU inference worker while keeping file tools, commands, approvals and saved sessions on your PC.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const github = 'https://github.com/sumitahmed/FreeCompute';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0e" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="FreeCompute" />
    <meta name="twitter:card" content="summary" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={primaryFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="brand" href={base} aria-label="FreeCompute home">
        <img class="brand-mark" src={`${base}favicon.svg`} width="32" height="32" alt="" />
        <span>FreeCompute</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#why`}>Why</a>
        <a href={`${base}#inside`}>Workflow</a>
        <a href={`${base}#how-it-works`}>Architecture</a>
        <a class="nav-github" href={github}>GitHub <Icon name="external" /></a>
        <a class="nav-start" href={`${base}#setup`}>Get started <Icon name="arrow" /></a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <div>
        <a class="brand" href={base}><img class="brand-mark" src={`${base}favicon.svg`} width="28" height="28" alt="" />FreeCompute</a>
        <p>Remote model. Local workflow.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href={github}>GitHub <Icon name="external" /></a>
        <a href={`${base}guide/`}>Setup guide <Icon name="arrow" /></a>
        <a href={`${github}/blob/main/LICENSE`}>Apache 2.0 <Icon name="external" /></a>
      </nav>
    </footer>
  </body>
</html>
