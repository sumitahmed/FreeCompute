# FreeCompute Environment Variables Template (.env.example)
# Copy to .env and fill in your values. Do NOT commit .env to source control!

# Remote supervisor endpoint (Tailscale IP:8081 or Cloudflare Tunnel URL)
FREECOMPUTE_REMOTE_URL=http://127.0.0.1:8081

# Bearer token for remote supervisor authentication
FREECOMPUTE_API_KEY=your-secure-bearer-token-here

# (Optional) Remote ComfyUI endpoint for image generation
FREECOMPUTE_IMAGE_SERVER=

# Model alias registered in llama-server
FREECOMPUTE_MODEL_ALIAS=qwen3.8-27b-huihui-abliterated-q4

# Local workspace directory
FREECOMPUTE_WORKSPACE=.

# Ingress transport mode (tailscale or cloudflare)
FREECOMPUTE_TRANSPORT=tailscale

# Request timeout in seconds (default 900)
FREECOMPUTE_TIMEOUT=900
